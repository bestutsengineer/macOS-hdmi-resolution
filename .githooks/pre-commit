#!/usr/bin/env bash
# Pre-commit checks before anything reaches a public repository.
#
#   1. gitleaks scans the staged changes for secrets.
#   2. The commit must not carry a personal email address: GitHub publishes
#      the author address of every commit. Use your GitHub noreply address,
#      shown under GitHub > Settings > Emails.
#
# Enable once per clone:  git config core.hooksPath .githooks
# Skip in an emergency:   git commit --no-verify
set -eu

if ! command -v gitleaks > /dev/null; then
    echo 'pre-commit: gitleaks is not installed; install it with: brew install gitleaks' >&2
    exit 1
fi
# gitleaks 8.19 and later name the command "git"; older versions "protect".
if gitleaks help git > /dev/null 2>&1; then
    gitleaks git --pre-commit --staged --redact --no-banner
else
    gitleaks protect --staged --redact --no-banner
fi

email=$(git var GIT_AUTHOR_IDENT | sed -E 's/.*<([^>]*)>.*/\1/')
case "$email" in
    *@users.noreply.github.com) ;;
    *)
        echo "pre-commit: the commit would be published with the address <$email>." >&2
        echo 'Set your GitHub noreply address for this repository:' >&2
        echo '  git config user.email "<id>+<username>@users.noreply.github.com"' >&2
        exit 1
        ;;
esac
